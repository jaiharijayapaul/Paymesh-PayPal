# ==========================================
# PayMesh — Environment Configuration
# ==========================================

# Application
PROJECT_NAME="PayMesh - AI Agent Commerce Network"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-production-jwt-secret-key-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is local SQLite (out-of-the-box Windows zero-install):
DATABASE_URL="sqlite:///./paymesh.db"
# For PostgreSQL (Docker Compose or Cloud Hosted):
# DATABASE_URL="postgresql://paymesh_user:paymesh_password@localhost:5432/paymesh_db"

# PayPal REST API Sandbox Configuration
# Obtain credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# Network URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"

# AI Provider Configuration
# Supported options: 'demo' (deterministic engine), 'gemini' (Google Gemini), 'claude' (Anthropic Claude)
AI_PROVIDER="demo"
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

{
  "apimatic": "3.0",
  "openapi": "3.0.3",
  "info": {
    "title": "PayPal Orders v2 API - APIMatic Context Definition",
    "description": "Validated OpenAPI 3.0 contract definition used by the APIMatic Context Plugin for PayMesh autonomous agent checkout integration.",
    "version": "2.0.0",
    "contact": {
      "name": "PayMesh Developer Platform",
      "url": "https://github.com/jaiharijayapaul/Paymesh-PayPal"
    }
  },
  "servers": [
    {
      "url": "https://api-m.sandbox.paypal.com",
      "description": "PayPal Sandbox Environment"
    },
    {
      "url": "https://api-m.paypal.com",
      "description": "PayPal Production Environment"
    }
  ],
  "paths": {
    "/v2/checkout/orders": {
      "post": {
        "summary": "Create an order",
        "description": "Creates an order to initiate the PayPal checkout process for autonomous agent commerce.",
        "operationId": "ordersCreate",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "return=representation"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/v2/checkout/orders/{id}/capture": {
      "post": {
        "summary": "Capture payment for order",
        "description": "Captures payment for an approved PayPal order.",
        "operationId": "ordersCapture",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Payment captured successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderRequest": {
        "type": "object",
        "required": ["intent", "purchase_units"],
        "properties": {
          "intent": {
            "type": "string",
            "enum": ["CAPTURE", "AUTHORIZE"]
          },
          "purchase_units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseUnitRequest"
            }
          },
          "application_context": {
            "$ref": "#/components/schemas/ApplicationContext"
          }
        }
      },
      "PurchaseUnitRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "reference_id": {
            "type": "string"
          },
          "custom_id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 127
          },
          "amount": {
            "$ref": "#/components/schemas/AmountWithBreakdown"
          }
        }
      },
      "AmountWithBreakdown": {
        "type": "object",
        "required": ["currency_code", "value"],
        "properties": {
          "currency_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "value": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
          }
        }
      },
      "ApplicationContext": {
        "type": "object",
        "properties": {
          "brand_name": {
            "type": "string"
          },
          "landing_page": {
            "type": "string"
          },
          "user_action": {
            "type": "string"
          },
          "return_url": {
            "type": "string"
          },
          "cancel_url": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["CREATED", "SAVED", "APPROVED", "VOIDED", "COMPLETED", "PAYER_ACTION_REQUIRED"]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "href": { "type": "string" },
                "rel": { "type": "string" },
                "method": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
